// ============================================
// Example 11: OOP Avanzato
// Eredità (figlio 'e), super ('o pate), metodi statici (fisso)
// ============================================

na famiglie Persona {
    costruttore(nome) {
        stu cos.nome = nome
    }

    saluta() {
        piglie "Ue, so' " + stu cos.nome
    }

    fisso categoria() {
        piglie "Essere umano"
    }
}

na famiglie Pizzaiolo figlio 'e Persona {
    costruttore(nome, specialita) {
        'o pate(nome)
        stu cos.specialita = specialita
        stu cos.pizzeFatte = 0
    }

    faiPizza(tipo) {
        stu cos.pizzeFatte = stu cos.pizzeFatte + 1
        piglie stu cos.nome + " ha sfornato na " + tipo + "!"
    }

    saluta() {
        piglie 'o pate.saluta() + " e faccio " + stu cos.specialita
    }

    fisso salutoDiClasse() {
        piglie "Nuje simm' pizzaiuoli"
    }
}

chist è gennaro = nu bell Pizzaiolo("Gennaro", "Margherita")

stamm a dì(gennaro.saluta())
stamm a dì(gennaro.faiPizza("Marinara"))
stamm a dì(gennaro.faiPizza("Diavola"))
stamm a dì("Pizze fatte: " + gennaro.pizzeFatte)
stamm a dì("Categoria: " + Persona.categoria())
stamm a dì("Static subclass: " + Pizzaiolo.salutoDiClasse())

// Fields, getters, setters and private members
na famiglie Forno {
    #temperatura = 20
    fisso forniAccesi = 0
    pizzeInForno = []

    damme temperatura() {
        piglie stu cos.#temperatura + "°C"
    }

    miette temperatura(gradi) {
        stu cos.#temperatura = stu cos.#limita(gradi)
    }

    #limita(gradi) {
        piglie Math.min(gradi, 485)
    }
}

chist è forno = nu bell Forno()
forno.temperatura = 900
stamm a dì("Forno: " + forno.temperatura)

// Static block: runs once, when the class is defined
na famiglie Menu {
    fisso pizze = []
    fisso {
        Menu.pizze.push("Margherita", "Marinara")
    }
}
stamm a dì("Menu: " + Menu.pizze.join(", "))

// A class as a value, and getters/setters in an object literal
chist è Ricetta = na famiglie {
    costruttore(nome) { stu cos.nome = nome }
}
tien grammi = 250
chist è impasto = {
    damme chili() { piglie grammi / 1000 },
    miette chili(kg) { grammi = kg * 1000 }
}
impasto.chili = 2
chist è ricetta = nu bell Ricetta("Pizza fritta")
stamm a dì(ricetta.nome + ": " + impasto.chili + " kg")
