// ============================================
// Example 16: 'A pizzeria cu JSX
// A React component written in FratmScript: JSX with Neapolitan tags
// (voce = li, citofono = button, core = main, ...), props, state and lists
// ============================================

chiamm { useState } da "react"

chist è MENU = [
    { nomme: "Margherita", prezzo: 5, piccante: sfòls },
    { nomme: "Diavola", prezzo: 7, piccante: overo },
    { nomme: "Marinara", prezzo: 4, piccante: sfòls },
]

// A component is a function that takes props and returns JSX
facc Pizza({ nomme, prezzo, piccante, ordina }) {
    piglie (
        <voce class="pizza">
            <fort>{nomme}</fort> &middot; {prezzo} €
            {piccante ? <scatulell title="Piccante">🌶️</scatulell> : nisciun}
            <citofono onClick={() => ordina(nomme)}>Ordina</citofono>
        </voce>
    )
}

mann for predefinit facc Pizzeria() {
    tien [ordine, setOrdine] = useState([])
    chist è totale = ordine
        .map((nomme) => MENU.find((p) => p.nomme === nomme).prezzo)
        .reduce((a, b) => a + b, 0)

    piglie (
        <core>
            <luccolone>Uè, benvenuto 'a pizzeria!</luccolone>
            <list>
                {MENU.map((pizza) => (
                    <Pizza key={pizza.nomme} {...pizza} ordina={(n) => setOrdine([...ordine, n])} />
                ))}
            </list>
            {ordine.length === 0
                ? <chiacchier>Ancora nisciuna pizza. Che te magne?</chiacchier>
                : <chiacchier>Hai ordinato {ordine.length} pizze: {totale} €</chiacchier>}
        </core>
    )
}
