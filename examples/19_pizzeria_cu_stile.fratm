// ============================================
// Example 19: 'A pizzeria cu stile
// A React page written all in Neapolitan: tags, attributes and events
// in JSX (cascett, classe, quanno-tuocche) and CSS with stile`…`,
// all translated at compile time
// ============================================

chiamm { useState } da "react"
chiamm { stile } da "fratm"

// The rules are added to the page once; plain CSS works here too
stile`
  core.pizzeria {
    scrittura: system-ui, sans-serif
    larghezza-massima: 420px
    margine: 0 automatico
    spazio: 16px
  }
  voce {
    mostra: flessibile
    giustifica: spartuto
    allinea-cose: miezo
    spazio: 8px 0
    bordo-sotto: 1px continuo #e2e0da
  }
  citofono {
    sfunno-culore: #c8321e
    culore: janco
    bordo: nisciuno
    bordo-tunno: 6px
    spazio: 6px 12px
    cursore: manella
  }
  citofono:passanno { opacità: 0.85 }
  chiacchier.totale { scrittura-peso: grassetto }
  @quanno (larghezza-massima: 480px) {
    core.pizzeria { spazio: 8px }
  }
`

chist è MENU = [
    { nomme: "Margherita", prezzo: 5 },
    { nomme: "Diavola", prezzo: 7 },
    { nomme: "Marinara", prezzo: 4 },
]

mann for predefinit facc Pizzeria() {
    tien [conto, setConto] = useState(0)
    piglie (
        <core classe="pizzeria">
            <luccolone>'A pizzeria cu stile</luccolone>
            <list>
                {MENU.map((p) => (
                    <voce chiave={p.nomme}>
                        <scatulell>{p.nomme} · {p.prezzo} €</scatulell>
                        <citofono quanno-tuocche={() => setConto(conto + p.prezzo)}>Pigliala</citofono>
                    </voce>
                ))}
            </list>
            <chiacchier classe="totale">Totale: {conto} €</chiacchier>
        </core>
    )
}
