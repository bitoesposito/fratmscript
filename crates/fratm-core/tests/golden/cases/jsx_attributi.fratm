// JSX attributes and events with Neapolitan names: on HTML tags they
// compile to the React props, on components they stay as written
chiamm { useState } da "react"

mann for predefinit facc Ordine({ pizze, Riga }) {
    tien [nomme, setNomme] = useState("")
    piglie (
        <modulo addo="/ordine" metodo="post" quanno-manne={(e) => e.preventDefault()}>
            <etichetta pe="nomme" classe="etichetta">Nomme</etichetta>
            <miett
                id="nomme"
                nomme="nomme"
                tipo="text"
                esempio="Totonno"
                valore={nomme}
                quanno-cagne={(e) => setNomme(e.target.value)}
                obbligatorio
                subbeto
            />
            <list>
                {pizze.map((p) => <voce chiave={p.id} quanno-tuocche={() => setNomme(p.nomme)}>{p.nomme}</voce>)}
            </list>
            <cartulin da="pizza.png" spiegazione="Na pizza" larghezza={120} altezza={80} />
            <vattenn addo="/" arape="_blank" titolo="Torna">Torna</vattenn>
            <cascett cess={{ color: "red" }} annascuso={nomme === ""} ruolo="status">Uè {nomme}</cascett>
            <citofono tipo="submit" stutato={nomme === ""} onClick={() => stamm a dì(nomme)}>Manna</citofono>
            <Riga tipo="pizza" quanno-tuocche={setNomme} />
        </modulo>
    )
}
