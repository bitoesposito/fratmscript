// JSX with Neapolitan tag names: they compile to the standard HTML tags
facc Modulo({ invia }) {
    piglie (
        <modulo onSubmit={invia}>
            <cappiell><luccolone>'A pizzeria</luccolone></cappiell>
            <core>
                <piezz>
                    <luccolo>Menù</luccolo>
                    <list>
                        <voce><fort>Margherita</fort> <corsivo>5 €</corsivo></voce>
                    </list>
                    <elenco><voce>Primma</voce></elenco>
                </piezz>
                <etichetta for="nomme">Nomme</etichetta>
                <miett id="nomme" />
                <ragionamento />
                <scegli><opzione>Pizza</opzione></scegli>
                <chiacchier>Scrive <scatulell>ccà</scatulell><acap /><codice>x</codice></chiacchier>
                <cartulin src="pizza.png" alt="pizza" />
                <vattenn href="/">Torna</vattenn>
                <stacc />
                <tavulat><fila><capocasella>A</capocasella><casella>1</casella></fila></tavulat>
                <tela />
                <cascett class="tasti"><citofono>Manna</citofono></cascett>
            </core>
            <tomtom />
            <fattariello />
            <pere>Fatto a Napule</pere>
            <div>I tag HTML vanno ancora</div>
        </modulo>
    )
}
