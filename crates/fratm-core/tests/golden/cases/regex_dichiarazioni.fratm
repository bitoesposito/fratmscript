// Regex literals and multiple declarations (#20)
tien r = /ab+/g, s = "xabbbyab"
chist è targa = /^[A-Z]{2}\d{3}[A-Z]{2}$/, barre = /[/]x\//
stamm a dì(s.match(r).join(","), targa.test("NA123BC"), barre.test("/x/"))
stamm a dì(s.replace(/b/gi, "c"))

// A slash after an operand is a division
tien a = 10, b = 4
stamm a dì(a / b, [8, 2][0] / 2, (a + 2) / 3)

tien c, d = 1
pe (tien i = 0, j = 3; i < j; i++, j--) {
    d *= 2
}
stamm a dì(c, d)
