// pruvamm / e si schiatta / aropp (try/catch/finally)
facc dividi(a, b) {
    pruvamm {
        si (b == 0) {
            iett nu bell Error("divisione pe' zero")
        }
        piglie a / b
    } e si schiatta (err) {
        stamm a dì("guaio:", err.message)
        piglie nisciun
    } aropp {
        stamm a dì("aggio diviso", a, "pe'", b)
    }
}

stamm a dì(dividi(10, 2))
stamm a dì(dividi(1, 0))

// try/finally senza catch: aropp gira pure quando se fa return
facc apri() {
    pruvamm {
        piglie "aperto"
    }
    aropp {
        stamm a dì("chiuso")
    }
}
stamm a dì(apri())

// aropp fuori da nu pruvamm è nu nomme qualsiasi
tien aropp = "dopo"
stamm a dì(aropp)
